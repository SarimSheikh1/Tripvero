{
  "name": "tripvero",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -k -n API,WEB \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w client",
    "start": "npm run start -w server",
    "seed": "npm run seed -w server",
    "test": "npm run test -w server",
    "dev:local": "node scripts/dev-local.mjs",
    "dev:sample": "node scripts/dev-local.mjs --seed",
    "seed:local": "node --env-file=server/.env.local server/seed.js"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "prettier": "^3.9.9"
  }
}

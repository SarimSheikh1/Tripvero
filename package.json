{
  "name": "tripvero",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -k -n API,WEB \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w client",
    "start": "npm run start -w server",
    "test": "npm run test -w server",
    "dev:local": "node scripts/dev-local.mjs",
    "admin:local": "node --env-file=server/.env.local server/setup-admin.js",
    "admin:setup": "node --env-file=server/.env server/setup-admin.js"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "prettier": "^3.9.9"
  }
}
